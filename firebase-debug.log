[debug] [2026-11-10T01:35:17.883Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/harpa-palavra/rulesets {"name":"projects/harpa-palavra/rulesets/5be05050-3707-4e05-9268-bcd03ef63bb6","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() { return request.auth != null; }\n    function admin() { return signedIn() && (request.auth.token.email == 'jusanmagno@gmail.com' || request.auth.token.admin == true); }\n    match /hymns/{hymn} { allow read: if true; allow write: if admin(); }\n    match /hymnEditions/{edition} { allow read: if true; allow write: if admin(); }\n    match /bibleTranslations/{translation} { allow read: if true; allow write: if admin(); }\n    match /bibleBooks/{book} { allow read: if true; allow write: if admin(); }\n    match /bibleVerses/{verse} { allow read: if true; allow write: if admin(); }\n    match /contentSources/{source} { allow read: if true; allow write: if admin(); }\n    match /importJobs/{job} { allow read, write: if admin(); }\n    match /users/{userId} {\n      allow read, create, update: if signedIn() && request.auth.uid == userId;\n      allow delete: if false;\n      match /favorites/{favorite} { allow read, write: if signedIn() && request.auth.uid == userId; }\n      match /playlists/{playlist} { allow read, write: if signedIn() && request.auth.uid == userId; }\n      match /readingProgress/{progress} { allow read, write: if signedIn() && request.auth.uid == userId; }\n      match /studyNotes/{note} { allow read, write: if signedIn() && request.auth.uid == userId; }\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-11-10T01:35:18.058351Z","metadata":{"services":["cloud.firestore"]}}
